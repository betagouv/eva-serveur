<div class="container">
  <h1>Démo TagDsfrComponent</h1>

  <p>Tag du DSFR : non cliquable (paragraphe) ou cliquable (bouton), en taille moyenne ou petite, avec une icône facultative.</p>

  <h2>Non cliquable</h2>
  <ul class="fr-tags-group">
    <li><%= render TagDsfrComponent.new(libelle: "Taille moyenne") %></li>
    <li><%= render TagDsfrComponent.new(libelle: "Petite taille", taille: :sm) %></li>
    <li><%= render TagDsfrComponent.new(libelle: "Avec icône", icone: "fr-icon-arrow-right-line") %></li>
  </ul>

  <h2>Cliquable</h2>
  <ul class="fr-tags-group">
    <li><%= render TagDsfrComponent.new(libelle: "Taille moyenne", cliquable: true) %></li>
    <li><%= render TagDsfrComponent.new(libelle: "Petite taille", cliquable: true, taille: :sm) %></li>
    <li><%= render TagDsfrComponent.new(libelle: "Avec icône", cliquable: true, icone: "fr-icon-arrow-right-line") %></li>
  </ul>
</div>
