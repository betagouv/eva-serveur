<div class="container">
  <h1>Démo TagComponent</h1>

  <h2>Tag simple</h2>
  <div class="fr-mb-3w">Taille par défaut (md) :
    <%= render Tag.new("Important") %>
  </div>
  <div class="fr-mb-3w">Taille sm :
    <%= render Tag.new("Important", taille: "sm") %>
  </div>

  <h2>Tag supprimable (le clic envoie un PATCH vers l'url)</h2>
  <div class="fr-mb-3w">Taille par défaut (md) :
    <%= render Tag.new("À supprimer", supprimable: true, url: "#") %>
  </div>
  <div class="fr-mb-3w">Taille sm :
    <%= render Tag.new("À supprimer", supprimable: true, url: "#", taille: "sm") %>
  </div>
</div>
