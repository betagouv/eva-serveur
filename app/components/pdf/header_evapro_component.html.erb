<%= render(HeaderComponent.new(
  logo: "logo/evapro.png",
  logo_alt: t("header.evapro.logo_alt"),
  titre: (@structure.nom if @avec_details),
  tagline: ("le #{l(@date, format: :short)} par #{@beneficiaire}" if @avec_details),
  classes: [ "header-pdf-evapro" ]
)) do |c| %>
  <% if @opco.present? && @opco.financeur?%>
    <% c.with_service_image do %>
      <%= image_tag(
        cdn_for(@opco.logo.variant(:defaut)),
        alt: @opco.nom,
        height: 70
      ) %>
    <% end %>
  <% end %>
<% end %>
