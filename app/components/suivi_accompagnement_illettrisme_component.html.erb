<div id="<%= @evaluation.id %>" class="<%= classes %>"
     <%= "data-personne-suivante=true" if tableau_de_bord? %>>
  <%= render EnteteMiseEnActionComponent.new(evaluation: @evaluation,
                                             lien_evaluation: tableau_de_bord?,
                                             compact: tableau_de_bord?) %>
  <div class="card__banner card__banner--illettrisme">
    <div class="suivi-mise-en-action">
      <div class="suivi-mise-en-action__contexte">
        <p class="fr-badge fr-badge--info fr-badge--sm">
          <%= t("suivi_accompagnement_illettrisme.badge") %>
        </p>
        <p class="suivi-mise-en-action__description">
          <%= t("suivi_accompagnement_illettrisme.description") %>
        </p>
      </div>
      <%= render QuestionMiseEnActionComponent.new(evaluation: @evaluation, reponses: reponses) %>
      <% %i[remediation difficulte].each do |questionnaire| %>
        <%= render QualificationMiseEnActionComponent.new(evaluation: @evaluation, questionnaire: questionnaire) %>
      <% end %>
      <% if MiseEnAction.pas_encore_actif? %>
        <%= render DateRevueMiseEnActionComponent.new(evaluation: @evaluation) %>
      <% end %>
      <% reponses.each do |reponse| %>
        <%= render ReponseMiseEnActionComponent.new(evaluation: @evaluation, reponse: reponse) %>
      <% end %>
    </div>
  </div>
</div>
