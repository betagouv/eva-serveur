<div class='bloc-evaluations bloc-apercu'>
  <div class='bloc-apercu-wrapper'>
    <div class="titre-panel-avec-bouton fr-mb-3v">
      <h3><%= t(".titre") %></h3>
      <%= render LienComponent.new(t(".voir_tout"), admin_evaluations_eva_path,
                                   class: "fr-link fr-icon-arrow-right-line fr-link--icon-right") %>
    </div>

    <p class="evaluation-legende" aria-label="<%= t(".legende_sr") %>">
      <%= render(PastilleComponent.new(etiquette: t(".legende_info"), couleur: "alerte")) %>
    </p>
  </div>

  <%= render TableauComponent.new(collection: evaluations, id: "dernieres-evaluations") do |tableau| %>
    <% tableau.colonne(titre: t(".nom")) do |evaluation| %>
      <div class="bloc-evaluations__nom">
        <span class="bloc-evaluations__pastille">
          <% if evaluation.illettrisme_potentiel? %>
            <%= render(PastilleComponent.new(tooltip_content: t("components.pastille.illettrisme_potentiel"), couleur: "alerte")) %>
          <% end %>
        </span>
        <%= link_to admin_evaluation_eva_path(evaluation), class: "fr-link fr-link--sm bloc-evaluations__lien",
                                                       title: evaluation.beneficiaire.nom do %>
          <%= render NomAnonymisableComponent.new(evaluation.beneficiaire) %>
        <% end %>
      </div>
    <% end %>
    <% tableau.colonne(titre: t(".date"), td_class: "fr-text--sm fr-mb-0") do |evaluation| %>
      <%= l(evaluation.created_at) %>
    <% end %>
  <% end %>
</div>
