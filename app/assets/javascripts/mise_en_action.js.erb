// Mise en action : partie commune à la fiche évaluation et au tableau de bord.
// Différences entre les deux écrans et pièges connus : docs/mise_en_action_ecrans.md
// Déclare les chemins et constantes venant de Ruby, utilisés par
// suivi_accompagnement_illettrisme.js.

const REPONSE_PAS_ENCORE = "<%= MiseEnAction::REPONSE_PAS_ENCORE %>";
const QUALIFICATION_AUTRE = "<%= MiseEnAction::QUALIFICATION_AUTRE %>";
const CHOIX_DATE_PRECISE = "<%= MiseEnAction::CHOIX_DATE_PRECISE %>";

const chemin_mise_en_action = "<%= Rails.application.routes.url_helpers.mise_en_action_admin_evaluation_eva_path('ID_EVALUATION') %>";
const chemin_renseigner_qualification = "<%= Rails.application.routes.url_helpers.renseigner_qualification_admin_evaluation_eva_path('ID_EVALUATION') %>";
const chemin_renseigner_date_revue = "<%= Rails.application.routes.url_helpers.renseigner_date_revue_admin_evaluation_eva_path('ID_EVALUATION') %>";
const chemin_tableau_de_bord = "<%= Rails.application.routes.url_helpers.admin_dashboard_path %>";

// Le tableau de bord ne propose qu'une personne à la fois : une fois la réponse complète,
// la page est rechargée pour remercier le pro et lui proposer la personne suivante.
function passeALaPersonneSuivante(evaluationId) {
  const carte = document.getElementById(evaluationId);
  if (!carte || !carte.hasAttribute('data-personne-suivante')) return false;

  window.location.href = `${chemin_tableau_de_bord}?suivi_enregistre=${evaluationId}`;
  return true;
}

function afficheModificationReponse(reponseMiseEnAction, evaluationId) {
  $(`#${evaluationId} .mise-en-action`).removeClass('d-flex').addClass('hidden');
  $(`#${evaluationId} div[data-reponse='${reponseMiseEnAction}']`).removeClass('hidden').addClass('d-flex');
}

function ouvreQcm(evaluationId, qcm, effectuee) {
  fermeQcm(evaluationId);
  let bouton_actif = $(`#${evaluationId} .reponse-mise-en-action[data-reponse='${effectuee}']`);
  bouton_actif.addClass('bouton--actif');
  bouton_actif.attr('aria-expanded', true);
  $(`#${evaluationId} .qcm`).addClass('hidden');
  $(`#${evaluationId} .questions-${qcm}`).removeClass('hidden');
}

function fermeQcm(evaluationId) {
  let boutons_reponses_mise_en_action = $(`#${evaluationId} .reponse-mise-en-action`);
  boutons_reponses_mise_en_action.removeClass('bouton--actif');
  boutons_reponses_mise_en_action.attr('aria-expanded', false);
  $(`#${evaluationId} .qcm`).addClass('hidden');
}

function modifieReponseMiseEnAction(evaluationId) {
  $(`#${evaluationId} .reponse-mise-en-action`).removeClass('bouton--actif');
  $(`#${evaluationId} .mise-en-action`).removeClass('d-flex').addClass('hidden');
  $(`#${evaluationId} div[data-reponse='vide']`).removeClass('hidden').addClass('d-flex');
}

function enregistreReponseMiseEnAction(evaluationId, bouton) {
  const reponse = bouton.data('reponse');
  const data = {
    mise_en_action_effectuee: reponse
  };
  $.ajax({
    method: 'PUT',
    url: chemin_mise_en_action.replace('ID_EVALUATION', evaluationId),
    data: data,
    dataType: "json",
    success: function (donnees) {
      if (reponse === REPONSE_PAS_ENCORE) {
        ouvreQcm(evaluationId, 'date-revue', reponse);
        return;
      }
      const qcm = nomQcm(reponse)
      // Le serveur efface la qualification de l'autre réponse, et avec elle sa précision
      fermePrecisionAutre($(`#${evaluationId} .questions-${nomQcm(!reponse)}`));
      ouvreQcm(evaluationId, qcm, reponse);
    }
  });
}

function nomQcm(miseEnActionEffectuee) {
  return miseEnActionEffectuee ? 'remediation' : 'difficulte';
}

function miseEnActionEffectuee($bouton) {
  return $bouton.closest('.qcm')[0].classList.contains('questions-remediation')
}

// Champ « Précisez » de la réponse « Autre », commun aux deux écrans (PrecisionAutreComponent,
// dans un bloc .zone-precision-autre). Le serveur juge la précision : le JS affiche son erreur.
const CLASSE_PRECISION_MASQUEE = 'zone-precision-autre--masquee';

function precisionSaisie($qcm) {
  return $qcm.find('input[name=precision_autre]').val();
}

function precisionAutreMasquee($qcm) {
  return $qcm.find('.zone-precision-autre').hasClass(CLASSE_PRECISION_MASQUEE);
}

// Entrée dans « Précisez » déclenche le bouton qui enregistre la réponse de l'écran
function valideAvecEntree($champs, selecteurBouton) {
  $champs.on('keydown', function(event) {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    $(event.currentTarget).closest('.qcm').find(selecteurBouton).trigger('click');
  });
}

function ouvrePrecisionAutre($qcm) {
  $qcm.find('.zone-precision-autre').removeClass(CLASSE_PRECISION_MASQUEE);
  $qcm.find('input[name=precision_autre]').trigger('focus');
}

// Un autre choix ou une autre réponse referme « Précisez » : le tag « Autre »,
// qui n'a pas été cliqué, est désélectionné
function fermePrecisionAutre($qcm) {
  $qcm.find(`[data-qualification='${QUALIFICATION_AUTRE}']`).attr('aria-pressed', 'false');
  masquePrecisionAutre($qcm);
}

function masquePrecisionAutre($qcm) {
  $qcm.find('.zone-precision-autre').addClass(CLASSE_PRECISION_MASQUEE);
  $qcm.find('input[name=precision_autre]').val('');
  effaceErreurPrecision($qcm);
}

function affichePrecisionEnErreurDepuis(xhr, $qcm) {
  const erreur = xhr.responseJSON && xhr.responseJSON.erreur;
  if (erreur) affichePrecisionEnErreur($qcm, erreur);
}

function affichePrecisionEnErreur($qcm, message) {
  afficheErreurChamp($qcm.find('.precision-autre'), message);
}

function effaceErreurPrecision($qcm) {
  effaceErreurChamp($qcm.find('.precision-autre'));
}

// Erreur d'un champ DSFR (fr-input-group) : « Précisez » ou la date de revue
function afficheErreurChamp($groupe, message) {
  effaceErreurChamp($groupe);
  $groupe.addClass('fr-input-group--error');
  $groupe.find('.fr-label').addClass('fr-label--error');
  $groupe.find('.fr-message--info').addClass('hidden');
  $groupe.find('.fr-messages-group').append($('<p class="fr-message fr-message--error">').text(message));
  $groupe.find('.fr-input').addClass('fr-input--error').trigger('focus');
}

function effaceErreurChamp($groupe) {
  $groupe.removeClass('fr-input-group--error');
  $groupe.find('.fr-label').removeClass('fr-label--error');
  $groupe.find('.fr-input').removeClass('fr-input--error');
  $groupe.find('.fr-message--error').remove();
  $groupe.find('.fr-message--info').removeClass('hidden');
}

function ecouteBoutons(boutons, callback) {
  boutons.on('click', function(event) {
    event.preventDefault();
    const evaluationId = event.currentTarget.closest('.carte__conteneur').getAttribute('id')
    callback(evaluationId, $(this));
  });
}

document.addEventListener('DOMContentLoaded', () => {
  ecouteBoutons($(".reponse-mise-en-action"), enregistreReponseMiseEnAction);
  ecouteBoutons($(".modifier-mise-en-action"), modifieReponseMiseEnAction);
});
