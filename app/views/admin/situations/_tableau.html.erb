<% tableau.colonne(titre: Situation.human_attribute_name(:illustration)) do |situation| %>
  <% illustration = situation_illustration(situation) %>
  <%= link_to illustration, admin_situation_path(situation) if illustration.present? %>
<% end %>
<% tableau.colonne(titre: Situation.human_attribute_name(:libelle), tri: "libelle", multiline: true) do |ressource| %>
  <%= link_to ressource.libelle, admin_situation_path(ressource) %>
<% end %>
<% tableau.colonne(titre: Situation.human_attribute_name(:nom_technique), tri: "nom_technique") do |ressource| %>
  <%= ressource.nom_technique %>
<% end %>
<% tableau.colonne(titre: Situation.human_attribute_name(:questionnaire)) do |ressource| %>
  <%= link_to ressource.questionnaire.libelle, admin_questionnaire_path(ressource.questionnaire) if ressource.questionnaire %>
<% end %>
<% tableau.colonne(titre: Situation.human_attribute_name(:questionnaire_entrainement)) do |ressource| %>
  <%= link_to ressource.questionnaire_entrainement.libelle, admin_questionnaire_path(ressource.questionnaire_entrainement) if ressource.questionnaire_entrainement %>
<% end %>
