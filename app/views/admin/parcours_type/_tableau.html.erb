<% tableau.colonne(titre: ParcoursType.human_attribute_name(:libelle), tri: "libelle", multiline: true) do |ressource| %>
  <%= link_to ressource.libelle, admin_parcours_type_path(ressource) %>
<% end %>
<% tableau.colonne(titre: ParcoursType.human_attribute_name(:actif), tri: "actif") do |ressource| %>
  <%= t("active_admin.status_tag.#{ressource.actif ? "yes" : "no"}") %>
<% end %>
<% tableau.colonne(titre: ParcoursType.human_attribute_name(:position), tri: "position") do |ressource| %>
  <%= ressource.position %>
<% end %>
<% tableau.colonne(titre: ParcoursType.human_attribute_name(:nom_technique), tri: "nom_technique") do |ressource| %>
  <%= ressource.nom_technique %>
<% end %>
<% tableau.colonne(titre: ParcoursType.human_attribute_name(:type_de_programme), tri: "type_de_programme") do |ressource| %>
  <%= t("activerecord.attributes.parcours_type.types_de_programme.#{ressource.type_de_programme}") if ressource.type_de_programme %>
<% end %>
<% tableau.colonne(titre: ParcoursType.human_attribute_name(:created_at), tri: "created_at") do |ressource| %>
  <%= l(ressource.created_at, format: :sans_heure) %>
<% end %>
