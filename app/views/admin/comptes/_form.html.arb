active_admin_form_for [ :admin, resource ] do |f|
  f.semantic_errors
  f.inputs do
    f.input :prenom
    f.input :nom
    f.input :email
    f.input :telephone
    f.input :role, as: :select, collection: collection_roles if can?(:edit_role, f.object)
    champ_structure(f)
    f.input :fonction, as: :select, collection: collection_fonctions
    f.input :service_departement

    if current_compte.au_moins_admin? && compte != current_compte
      f.input :statut_validation, as: :radio
    end
    if peut_modifier_mot_de_passe?
      li class: "input password" do
        render PasswordInputComponent.new(
          id: "compte_password",
          label: Compte.human_attribute_name(:password),
          hint: resource.persisted? ? t(".aide_mot_de_passe") : nil,
          form: f.form_builder,
          method: :password,
          required: resource.new_record?,
          autocomplete: "new-password"
        )
      end
      li class: "input password" do
        render PasswordInputComponent.new(
          id: "compte_password_confirmation",
          label: Compte.human_attribute_name(:password_confirmation),
          form: f.form_builder,
          method: :password_confirmation,
          required: resource.new_record?,
          autocomplete: "new-password"
        )
      end
    end
  end
  f.actions do
    f.action :submit
    annulation_formulaire(f)
  end
end
