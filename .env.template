# macOS uniquement : évite un crash (garde-fou fork()/Objective-C) quand Puma
# en mode cluster (config/puma.rb, workers) fork un worker pendant qu'un thread
# d'arrière-plan (ex. YJIT) est actif dans le process maître. Sans effet et non
# nécessaire en production (Linux).
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

PROTOCOLE_SERVEUR=http
# Bouton « Télécharger une attestation de passation » sur les restitutions Evapro (EVA-1179). Si absent ou vide : bouton et route désactivés.
ACTIVE_ATTESTATION_PASSATION_EVAPRO=true
# Étape « usage » (choix eva / evapro) dans le parcours d'inscription structure. Si absent ou vide : création directe en eva pour les structures non entreprise.
ETAPE_USAGE_INSCRIPTION=true
# Début du suivi des mises en action (AAAA-MM-JJ, EVA-1193) : seules les évaluations passées à partir de cette date ont un statut de suivi. Si absent ou vide : aucune évaluation n'a de statut de suivi (tiret).
DATE_STATUT_SUIVI=2025-01-01
# Remplir la variable d'env pour faire apparaitre le bouton "Je ne sais pas" des mises en action dashboard et evaluations (Par defaut desactivé)
ACTIVE_MISE_EN_ACTION_JE_NE_SAIS_PAS=true
HOTE_SERVEUR=localhost:3000
URL_CLIENT=http://localhost:7700/jeu
URL_EVA_ENTREPRISES=http://localhost:5173
URL_SITE_VITRINE=https://eva.anlci.gouv.fr
LIEN_INSCRIPTION_PRESENTATION=https://eva.anlci.gouv.fr/formation-et-presentation/
METABASE_SITE_URL=http://metabase.eva.anlci.gouv.fr
METABASE_SECRET_KEY=<SECRET_METABASE>
METABASE_OPCO_DASHBOARD_ID=61
PRO_CONNECT_CLIENT_ID=<client_id_Pro_connect>
PRO_CONNECT_CLIENT_SECRET=<SECRET_PROCONNECT>
PRO_CONNECT_BASE_URL=https://fca.integ01.dev-agentconnect.fr
RECAPTCHA_SITE_KEY=<SITE_KEY>
RECAPTCHA_SECRET_KEY=<SECRET_KEY>
DEBUG_PDF=true
SIRENE_API_URL=https://recherche-entreprises.api.gouv.fr
EXPORT_XLS_NOMBRE_MAX_LIGNES=3000
PREFIXES_CODE_EXCLUS="LOL GAG"
MOT_DE_PASS_COMPTES_PREPROD='------------------------------------------------------------'
# Bucket S3 (service « amazon » de config/storage.yml) où sont stockés les fichiers
# des blobs chargés par bin/reviewappdeploy.sh (illustrations, audios…).
# Reprendre les valeurs de la pré-prod
AWS_BUCKET=<BUCKET_PREPROD>
AWS_ACCESS_KEY_ID=<ACCESS_KEY_ID_PREPROD>
AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY_PREPROD>
