attributes_table_for resource do
  row Evaluation.human_attribute_name("beneficiaire") do |restitution|
    restitution.evaluation.beneficiaire.nom
  end
  row :situation
  row :date
  row(t("admin.restitutions.evaluation.nombre_evenements")) do |restitution|
    restitution.evenements.count
  end
  row(t("admin.restitutions.evaluation.etat")) do |restitution|
    if restitution.termine?
      status_tag t("admin.restitutions.evaluation.termine"), class: "vert"
    elsif restitution.abandon?
      status_tag t("admin.restitutions.evaluation.abandon"), class: "rouge"
    else
      status_tag t("admin.restitutions.evaluation.en_cours"), class: "gris"
    end
  end
  row(t("admin.restitutions.evaluation.temps")) do |restitution|
    formate_duree(restitution.temps_total)
  end
end
