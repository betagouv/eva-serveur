<%= render FiltresComponent.new(url: admin_beneficiaires_path, id: "filtres-beneficiaires",
                                parametres_conserves: { order: params[:order] }) do |filtres| %>
  <% filtres.with_recherche(champ: :recherche, libelle: t(".recherche"), valeur: @filtres.recherche) %>
  <% filtres.with_filtre(titre: Beneficiaire.human_attribute_name(:statut_suivi),
                         actifs: @filtres.statuts.size) do %>
    <%= render Filtres::CasesACocherComponent.new(champ: :statut_suivi_in,
                                                  libelle: Beneficiaire.human_attribute_name(:statut_suivi),
                                                  options: @filtres.options_statuts,
                                                  valeurs: @filtres.statuts) %>
  <% end %>
  <% filtres.with_filtre(titre: Beneficiaire.human_attribute_name(:created_at),
                         actifs: @filtres.nombre_bornes_creation) do %>
    <%= render Filtres::PeriodeComponent.new(champ: :created_at,
                                             libelle: Beneficiaire.human_attribute_name(:created_at),
                                             debut: @filtres.creation_debut,
                                             fin: @filtres.creation_fin) %>
  <% end %>
  <% filtres.with_filtre(titre: Campagne.model_name.human, valeur: @filtres.campagne&.display_name,
                         application_immediate: true) do %>
    <%= render Filtres::RechercheComponent.new(champ: :evaluations_campagne_id_eq,
                                               libelle: Campagne.model_name.human,
                                               url: admin_campagnes_path(format: :json, order: "libelle_asc"),
                                               champs_recherche: %i[libelle code],
                                               valeur: @filtres.campagne_id,
                                               libelle_valeur: @filtres.campagne&.display_name) %>
  <% end %>
  <% if @filtres.filtre_structure? %>
    <% filtres.with_filtre(titre: Structure.model_name.human, valeur: @filtres.structure&.display_name,
                           application_immediate: true) do %>
      <%= render Filtres::RechercheComponent.new(champ: :evaluations_campagne_compte_structure_id_eq,
                                                 libelle: Structure.model_name.human,
                                                 url: admin_structures_path(format: :json, order: "lower_nom_asc"),
                                                 champs_recherche: %i[nom code_postal],
                                                 valeur: @filtres.structure_id,
                                                 libelle_valeur: @filtres.structure&.display_name) %>
    <% end %>
  <% end %>
<% end %>
