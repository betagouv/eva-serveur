function afficheModificationReponse(reponseMiseEnAction, evaluationId) {
  $(`#${evaluationId} .mise-en-action`).removeClass('d-flex').addClass('hidden');
  $(`#${evaluationId} div[data-reponse='${reponseMiseEnAction}']`).removeClass('hidden').addClass('d-flex');
}

const REPONSE_JE_NE_SAIS_PAS = "<%= MiseEnAction::REPONSE_JE_NE_SAIS_PAS %>";

function afficheReponseJeNeSaisPas(evaluationId, revuePrevue) {
  fermeQcm(evaluationId);
  $(`#${evaluationId} .mise-en-action`).removeClass('d-flex').addClass('hidden');
  const $reponse = $(`#${evaluationId} div[data-reponse='${REPONSE_JE_NE_SAIS_PAS}']`);
  $reponse.find('.tag').removeClass('hidden').text(revuePrevue);
  $reponse.removeClass('hidden').addClass('d-flex');
}

function reinitialiseFormulaire(evaluationId) {
  $(`#${evaluationId} input[name=reponse_qcm]`).prop('checked', false);
  $(`#${evaluationId} .valide-qcm`).prop('disabled', true);
}

function ouvreQcm(evaluationId, qcm, effectuee) {
  fermeQcm(evaluationId);
  let bouton_actif = $(`#${evaluationId} .reponse-mise-en-action[data-reponse='${effectuee}']`);
  bouton_actif.addClass('bouton--actif');
  bouton_actif.attr('aria-expanded', true);
  $(`#${evaluationId} .carte-liste`).addClass('carte--deroulee');
  $(`#${evaluationId} .qcm`).addClass('hidden');
  $(`#${evaluationId} .questions-${qcm}`).removeClass('hidden');
}

function fermeQcm(evaluationId) {
  let boutons_reponses_mise_en_action = $(`#${evaluationId} .reponse-mise-en-action`);
  boutons_reponses_mise_en_action.removeClass('bouton--actif');
  boutons_reponses_mise_en_action.attr('aria-expanded', false);
  $(`#${evaluationId} .carte-liste`).removeClass('carte--deroulee');
  $(`#${evaluationId} .qcm`).addClass('hidden');
  reinitialiseFormulaire(evaluationId);
}

function modifieReponseMiseEnAction(evaluationId) {
  $(`#${evaluationId} .reponse-mise-en-action`).removeClass('bouton--actif');
  $(`#${evaluationId} .mise-en-action`).removeClass('d-flex').addClass('hidden');
  $(`#${evaluationId} div[data-reponse='vide']`).removeClass('hidden').addClass('d-flex');
}

const chemin_mise_en_action = "<%= Rails.application.routes.url_helpers.mise_en_action_admin_evaluation_eva_path('ID_EVALUATION') %>";
const chemin_renseigner_qualification = "<%= Rails.application.routes.url_helpers.renseigner_qualification_admin_evaluation_eva_path('ID_EVALUATION') %>";

function enregistreReponseMiseEnAction(evaluationId, bouton) {
  const reponse = bouton.data('reponse');
  const data = {
    mise_en_action_effectuee: reponse
  };
  $.ajax({
    method: 'PUT',
    url: chemin_mise_en_action.replace('ID_EVALUATION', evaluationId),
    data: data,
    dataType: "json",
    success: function (donnees) {
      if (reponse === REPONSE_JE_NE_SAIS_PAS) {
        afficheReponseJeNeSaisPas(evaluationId, donnees.revue_prevue);
        return;
      }
      const qcm = nomQcm(reponse)
      // Le serveur efface la qualification de l'autre réponse, et avec elle sa précision
      fermePrecisionAutre($(`#${evaluationId} .questions-${nomQcm(!reponse)}`));
      ouvreQcm(evaluationId, qcm, reponse);
    }
  });
}

function activeBoutonValider() {
  const radios = $('input[name=reponse_qcm]');

  radios.each(function() {
    const radio = $(this)
    radio.on("click", function(event) {
      radio.closest('.qcm').find('.valide-qcm').prop('disabled', false);
    })
  });
}

function enregistreQualificationMiseEnAction(evaluationId, $bouton, { ignorer }) {
  const effectuee = miseEnActionEffectuee($bouton)
  const qualification = ignorer ? 'indetermine' : reponseSelectionnee(evaluationId, nomQcm(effectuee));

  $.ajax({
    method: 'PATCH',
    url: chemin_renseigner_qualification.replace('ID_EVALUATION', evaluationId),
    data: { effectuee, qualification },
    dataType: "json",
    success: function () {
      afficheModificationReponse(effectuee, evaluationId);
      fermeQcm(evaluationId);
    }
  });
}

function nomQcm(miseEnActionEffectuee) {
  return miseEnActionEffectuee ? 'remediation' : 'difficulte';
}

function reponseSelectionnee(evaluationId, qcm) {
  return $(`#${evaluationId} .questions-${qcm} input[name=reponse_qcm]:checked`).val();
}

function miseEnActionEffectuee($bouton) {
  return $bouton.closest('.qcm')[0].classList.contains('questions-remediation')
}

const QUALIFICATION_AUTRE = "<%= MiseEnAction::QUALIFICATION_AUTRE %>";
const CLASSE_PRECISION_MASQUEE = 'qualification-mise-en-action__precision--masquee';

// Carte de suivi de l'évaluation : le clic sur un tag enregistre directement la qualification,
// sauf « Autre » qui ouvre « Précisez » et s'enregistre avec « Enregistrer »
function enregistreChoixQualification(evaluationId, $tag) {
  const $qcm = $tag.closest('.qcm');
  if ($tag.data('qualification') === QUALIFICATION_AUTRE) {
    basculePrecisionAutre($qcm);
    return;
  }
  fermePrecisionAutre($qcm);
  renseigneQualification(evaluationId, $tag, { qualification: $tag.data('qualification') });
}

function enregistrePrecisionAutre(evaluationId, $bouton) {
  const $qcm = $bouton.closest('.qcm');
  renseigneQualification(evaluationId, $bouton, {
    qualification: QUALIFICATION_AUTRE,
    precision_autre: $qcm.find('input[name=precision_autre]').val()
  });
}

function renseigneQualification(evaluationId, $element, donneesQualification) {
  const effectuee = miseEnActionEffectuee($element);

  $.ajax({
    method: 'PATCH',
    url: chemin_renseigner_qualification.replace('ID_EVALUATION', evaluationId),
    data: { effectuee, ...donneesQualification },
    dataType: "json",
    success: function (donnees) {
      const $reponse = $(`#${evaluationId} div[data-reponse='${effectuee}']`);
      $reponse.find('.tag').removeClass('hidden').text(donnees.qualification);
      $reponse.find('.mise-en-action-repondue__date').text(donnees.repondue_le);
      $reponse.find('.mise-en-action-repondue__date, .mise-en-action-repondue__separateur').removeClass('hidden');
      afficheModificationReponse(effectuee, evaluationId);
      fermeQcm(evaluationId);
    },
    error: function (xhr) {
      const erreur = xhr.responseJSON && xhr.responseJSON.erreur;
      if (erreur) affichePrecisionEnErreur($element.closest('.qcm'), erreur);
    }
  });
}

// Au clic sur « Autre », le DSFR bascule lui-même aria-pressed (tag sélectionnable)
function basculePrecisionAutre($qcm) {
  if ($qcm.find(`.${CLASSE_PRECISION_MASQUEE}`).length) {
    ouvrePrecisionAutre($qcm);
  } else {
    masquePrecisionAutre($qcm);
  }
}

function ouvrePrecisionAutre($qcm) {
  $qcm.find('.qualification-mise-en-action__precision').removeClass(CLASSE_PRECISION_MASQUEE);
  $qcm.find('input[name=precision_autre]').trigger('focus');
}

// Un autre choix referme « Précisez » : le tag « Autre » n'a pas été cliqué, on le désélectionne
function fermePrecisionAutre($qcm) {
  $qcm.find(`[data-qualification='${QUALIFICATION_AUTRE}']`).attr('aria-pressed', 'false');
  masquePrecisionAutre($qcm);
}

function masquePrecisionAutre($qcm) {
  $qcm.find('.qualification-mise-en-action__precision').addClass(CLASSE_PRECISION_MASQUEE);
  $qcm.find('input[name=precision_autre]').val('');
  effaceErreurPrecision($qcm);
}

function affichePrecisionEnErreur($qcm, message) {
  const $groupe = $qcm.find('.precision-autre');
  effaceErreurPrecision($qcm);
  $groupe.addClass('fr-input-group--error');
  $groupe.find('.fr-label').addClass('fr-label--error');
  $groupe.find('.fr-message--info').addClass('hidden');
  // En premier : le DSFR espace le champ de son premier message (.fr-message:first-child)
  $groupe.find('.fr-messages-group').prepend($('<p class="fr-message fr-message--error">').text(message));
  $groupe.find('.fr-input').addClass('fr-input--error').trigger('focus');
}

function effaceErreurPrecision($qcm) {
  const $groupe = $qcm.find('.precision-autre');
  $groupe.removeClass('fr-input-group--error');
  $groupe.find('.fr-label').removeClass('fr-label--error');
  $groupe.find('.fr-input').removeClass('fr-input--error');
  $groupe.find('.fr-message--error').remove();
  $groupe.find('.fr-message--info').removeClass('hidden');
}

function ecouteBoutons(boutons, callback) {
  boutons.on('click', function(event) {
    event.preventDefault();
    const evaluationId = event.currentTarget.closest('.carte__conteneur').getAttribute('id')
    callback(evaluationId, $(this));
  });
}

document.addEventListener('DOMContentLoaded', () => {
  ecouteBoutons($(".reponse-mise-en-action"), enregistreReponseMiseEnAction);
  ecouteBoutons($(".modifier-mise-en-action"), modifieReponseMiseEnAction);
  ecouteBoutons($(".valide-qcm"), function(evaluationId, $bouton) {
    enregistreQualificationMiseEnAction(evaluationId, $bouton, { ignorer: false });
  });
  ecouteBoutons($(".bouton-fermer"), function(evaluationId, $bouton) {
    enregistreQualificationMiseEnAction(evaluationId, $bouton, { ignorer: true })
  });
  ecouteBoutons($(".valide-qcm"), function(evaluationId, $bouton) {
    const effectuee = miseEnActionEffectuee($bouton)
    const qcm = nomQcm(effectuee)
    const reponse = reponseSelectionnee(evaluationId, qcm);
    const traduction = I18n.t(`activerecord.attributes.mise_en_action.${qcm}.${reponse}`)
    $(`div[data-reponse='${effectuee}'] .tag`).removeClass('hidden').text(traduction);
  });
  ecouteBoutons($(".bouton-fermer"), function(evaluationId, $bouton) {
    const effectuee = miseEnActionEffectuee($bouton)
    $(`div[data-reponse='${effectuee}'] .tag`).addClass('hidden')
  });
  ecouteBoutons($(".suivi-accompagnement-illettrisme .reponse-mise-en-action"), function(evaluationId) {
    $(`#${evaluationId} div[data-reponse='vide']`).removeClass('d-flex').addClass('hidden');
  });
  ecouteBoutons($(".changer-reponse-mise-en-action"), function(evaluationId) {
    fermeQcm(evaluationId);
    modifieReponseMiseEnAction(evaluationId);
  });
  ecouteBoutons($(".choix-qualification-mise-en-action"), enregistreChoixQualification);
  ecouteBoutons($(".enregistre-precision-autre"), enregistrePrecisionAutre);
  $("input[name=precision_autre]").on('keydown', function(event) {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    $(event.currentTarget).closest('.qcm').find('.enregistre-precision-autre').trigger('click');
  });
  activeBoutonValider();
  $("input[name=reponse_qcm]").on('focus', function(event) {
    $(event.currentTarget).click();
  });
});
