<% scope = "activerecord.attributes.mise_en_action.#{mise_en_action.questionnaire}" if mise_en_action %>
<% pas_de_qualification = mise_en_action&.qualification_indeterminee? %>

<div data-reponse="<%= reponse_mise_en_action %>" class="mise-en-action flex-column <%= modification_affichee ? "d-flex" : "hidden" %>">
  <span><%= t(".reponse_#{reponse_mise_en_action}_html") %></span>
  <% if affiche_qualification %>
    <% if reponse_mise_en_action == MiseEnAction::REPONSE_JE_NE_SAIS_PAS %>
      <% contenu = mise_en_action&.date_revue ? t(".revue_prevue", date: l(mise_en_action.date_revue)) : "" %>
    <% else %>
      <% contenu = mise_en_action&.qualification ? t("#{mise_en_action.qualification}", scope: scope) : "" %>
    <% end %>
    <% classes_qualification = "qualification-mise-en-action fr-my-2v#{" hidden" if pas_de_qualification}" %>
    <div><%= render(BadgeComponent.new(contenu: contenu, class_couleur: "fr-badge--success", taille: "sm",
                                       sans_marge_basse: false, classes: classes_qualification)) %></div>
  <% end %>
  <span>(<a href="#" class="modifier-mise-en-action"><%= t(".modifier_reponse") %></a>)</span>
</div>
