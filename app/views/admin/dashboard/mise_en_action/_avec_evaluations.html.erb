<div class="contenu-avec-evaluations">
  <div class="titre-panel-avec-bouton fr-p-6v fr-mb-0">
    <h3><%= t(".titre") %></h3>
    <%= link_to t(".voir_tout"),
        admin_evaluations_eva_path(scope: :illettrisme_potentiel),
        class: "fr-btn fr-btn--secondary fr-btn--md" %>
  </div>
  <div class="fr-px-4v fr-py-4v">
    <%= render(EnteteMiseEnActionComponent.new(evaluation: evaluation, avec_lien_evaluation: true)) %>
    <p class="fr-mt-4v"><%= t(".introduction") %></p>
    <div class="fr-mt-4v d-flex gap-3">
      <%= button_to t(".bouton_oui"),
          repondre_suivi_tableau_de_bord_admin_evaluation_eva_path(evaluation),
          method: :put,
          params: { mise_en_action_effectuee: "true" },
          class: "fr-btn fr-btn--md" %>
      <%= button_to t(".bouton_non"),
          repondre_suivi_tableau_de_bord_admin_evaluation_eva_path(evaluation),
          method: :put,
          params: { mise_en_action_effectuee: "false" },
          class: "fr-btn fr-btn--secondary fr-btn--md" %>
      <%= button_to t(".bouton_pas_encore"),
          repondre_suivi_tableau_de_bord_admin_evaluation_eva_path(evaluation),
          method: :put,
          params: { mise_en_action_effectuee: MiseEnAction::REPONSE_PAS_ENCORE },
          class: "fr-btn fr-btn--tertiary fr-btn--md" %>
    </div>
  </div>
</div>
