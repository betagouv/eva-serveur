<div data-reponse="vide" class="mise-en-action question-mise-en-action <%= classe_question %>">
  <% if rappel_pas_encore %>
    <div class="question-mise-en-action__rappel"><%= rappel_pas_encore %></div>
  <% end %>
  <div class="question-mise-en-action__texte">
    <div id="question-mise-en-action-<%= @evaluation.id %>" class="question-mise-en-action__libelle">
      <%= t("question_mise_en_action.question") %>
    </div>
  </div>
  <div class="question-mise-en-action__boutons">
    <% @reponses.each do |reponse| %>
      <%= render BoutonDsfrComponent.new(
        "#",
        type: :secondary,
        tag: :button,
        size: :sm,
        class: "reponse-mise-en-action",
        data: { reponse: reponse.to_s },
        "aria-describedby": "question-mise-en-action-#{@evaluation.id}",
        "aria-expanded": "false"
      ) do %>
        <%= libelle_bouton(reponse) %>
      <% end %>
    <% end %>
  </div>
</div>
