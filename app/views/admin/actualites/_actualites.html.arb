div class: "actualites" do
  actualites.each do |actualite|
    render(
      CardComponent.new(
        titre: actualite.titre,
        url: admin_actualite_path(actualite),
        image_url: (cdn_for(actualite.illustration) if actualite.illustration.attached?),
        image_alt: "",
        size: :sm,
        classes: [ "actualite-card" ],
        badges: [
          {
            contenu: t(actualite.categorie, scope: "activerecord.attributes.actualite.categories"),
            class_couleur: classe_badge_categorie_actualite(actualite.categorie)
          }
        ],
        detail_start: l(actualite.created_at, format: :sans_heure)
      )
    )
  end
end
