<%= render TableauComponent.new(collection: collection, id: "structures", ordre: params[:order]) do |tableau| %>
  <% tableau.colonne(titre: StructureLocale.human_attribute_name(:nom), tri: "nom", multiline: true) do |structure| %>
    <%= link_to structure.nom, admin_structure_locale_path(structure) %>
  <% end %>
  <% tableau.colonne(titre: StructureLocale.human_attribute_name(:type_structure), multiline: true) do |structure| %>
    <%= traduction_type_structure(structure.type_structure) %>
  <% end %>
  <% if current_compte.anlci? %>
    <% tableau.colonne(titre: StructureLocale.human_attribute_name(:usage)) do |structure| %>
      <%= render BadgeComponent.new(contenu: traduction_usage(structure.usage),
                                    class_couleur: classe_badge_usage(structure.usage)) %>
    <% end %>
  <% end %>
  <% tableau.colonne(titre: StructureLocale.human_attribute_name(:code_postal), tri: "code_postal", multiline: true) do |structure| %>
    <%= structure.code_postal %>
  <% end %>
  <% tableau.colonne(titre: StructureLocale.human_attribute_name(:created_at), tri: "created_at") do |structure| %>
    <%= l(structure.created_at, format: :sans_heure) %>
  <% end %>
  <% tableau.colonne(titre: StructureLocale.human_attribute_name(:nombre_evaluations),
                     tri: "nombre_evaluations", multiline: true, td_class: "fr-cell--right") do |structure| %>
    <%= structure.nombre_evaluations %>
  <% end %>
  <% tableau.colonne(titre: StructureLocale.human_attribute_name(:date_derniere_evaluation),
                     tri: "date_derniere_evaluation", multiline: true) do |structure| %>
    <%= l(structure.date_derniere_evaluation, format: :sans_heure) if structure.date_derniere_evaluation %>
  <% end %>
  <% tableau.colonne(td_class: "col-actions tableau-boutons-action") do |structure| %>
    <%= render MenuActionsComponent.new(structure, *actions_structure(:structure_locale)) %>
  <% end %>
  <% tableau.with_pied do %>
    <div class="fr-table__footer--start">
      <p class="fr-table__detail"><%= t("admin.structures.liste.nombre_structures", count: collection.total_count) %></p>
    </div>
    <div class="fr-table__footer--middle">
      <%= paginate collection, theme: "dsfr" %>
    </div>
  <% end %>
<% end %>
