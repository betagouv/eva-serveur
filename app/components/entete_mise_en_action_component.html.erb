<div class="<%= classes %>">
  <div class="entete-mise-en-action__identification">
    <div class="entete-mise-en-action__nom">
      <%= render NomAnonymisableComponent.new(@evaluation.beneficiaire) if @evaluation.beneficiaire %>
    </div>
    <div class="entete-mise-en-action__date-et-lien">
      <span class="entete-mise-en-action__date"><%= date_evaluation %></span>
      <% if lien_evaluation? %>
        <%= render LienComponent.new(t("entete_mise_en_action.voir_evaluation"),
                                     admin_evaluation_eva_path(@evaluation)) %>
      <% end %>
    </div>
  </div>
  <div class="entete-mise-en-action__resultats">
    <% resultats.each do |resultat| %>
      <%= render resultat %>
    <% end %>
  </div>
</div>
